DATABASE_URL=postgres://performance:performance@localhost:5433/performance_coach?sslmode=disable

# Local-only Firebase project id. Not a real Firebase project; only used to
# satisfy the Admin SDK's config, since verification is redirected to the
# Auth Emulator below. Do not put real Firebase credentials here.
FIREBASE_PROJECT_ID=performance-coach-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# apps/web (Next.js) — client-side Firebase config. Same local-only,
# non-production emulator project as above; the API key is a placeholder
# the emulator does not validate.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=performance-coach-local
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key

# Domain that hosts the Google sign-in popup handler
# (https://<authDomain>/__/auth/handler). Public web configuration, not a
# secret. Leave it unset locally: the Auth Emulator above serves its own
# sign-in handler and ignores it. In a deployed environment it must be set
# to the Firebase project's auth domain (e.g. <project>.firebaseapp.com), or
# "Continue with Google" fails with auth/auth-domain-config-required.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# iOS OAuth client ID for Google sign-in inside the Capacitor shell. The
# WKWebView cannot run the popup flow, so iOS uses Google's native sheet
# instead and exchanges its ID token for a Firebase credential — see
# docs/tasks/2026-08-23-ios-google-signin-webview.md.
#
# Public client configuration, not a secret: an installed app's OAuth client
# ID ships inside the app binary by design. No client secret belongs here.
# Obtain it by registering an iOS app (bundle id com.performancecoach.app)
# in the Firebase console; it is the CLIENT_ID in the generated
# GoogleService-Info.plist. The matching REVERSED_CLIENT_ID must also be set
# as GOOGLE_REVERSED_CLIENT_ID in apps/web/ios/debug.xcconfig.
# Unset locally and on web-only deployments; only the iOS build needs it.
# NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple REST API (account deletion token exchange + revoke).
# All four must be set together in any environment that supports Apple-linked
# deletion. Leave unset locally if Apple deletion is not being tested.
# Never commit real key material; APPLE_PRIVATE_KEY is the .p8 PEM contents.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=com.pumpslate.app
# APPLE_PRIVATE_KEY=
