DATABASE_URL=postgres://performance:performance@localhost:5433/performance_coach?sslmode=disable

# Local-only Firebase project id. Not a real Firebase project; only used to
# satisfy the Admin SDK's config, since verification is redirected to the
# Auth Emulator below. Do not put real Firebase credentials here.
FIREBASE_PROJECT_ID=performance-coach-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# apps/web (Next.js) — client-side Firebase config. Same local-only,
# non-production emulator project as above; the API key is a placeholder
# the emulator does not validate.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=performance-coach-local
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key

# Domain that hosts the Google sign-in popup handler
# (https://<authDomain>/__/auth/handler). Public web configuration, not a
# secret. Leave it unset locally: the Auth Emulator above serves its own
# sign-in handler and ignores it. In a deployed environment it must be set
# to the Firebase project's auth domain (e.g. <project>.firebaseapp.com), or
# "Continue with Google" fails with auth/auth-domain-config-required.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
